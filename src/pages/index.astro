---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import ProjectFeaturedCard from "../components/ProjectFeaturedCard.astro";
import ProjectSecondaryCard from "../components/ProjectSecondaryCard.astro";
import SkillsMatrix from "../components/SkillsMatrix.astro";
import CertificationsBento from "../components/CertificationsBento.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const yanesuProject = projects.find((p) => p.id === "yanesu-shisutemu");
const tallerProject = projects.find((p) => p.id === "taller-admin");
---

<Layout>
  <Navbar />

  <!-- Hero -->
  <section class="pt-32 pb-20 px-4 max-w-5xl mx-auto w-full">
    <Hero />
  </section>

  <!-- Proyectos -->
  <section
    id="proyectos"
    class="scroll-reveal scroll-mt-28 max-w-5xl mx-auto px-4 py-16 space-y-8"
  >
    <!-- Encabezado de sección -->
    <div class="space-y-2">
      <span
        class="font-mono text-xs text-emerald-400 tracking-wider uppercase"
        style={`font-family: var(--font-mono)`}
      >
        01 / ARQUITECTURA DE SOFTWARE
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-white leading-tight">
        Sistemas transaccionales &amp;&nbsp;<em
          class="not-italic"
          style={`font-family: var(--font-serif); font-style: italic; font-weight: 400; color: #d4d4d8;`}
          >proyectos en producción</em
        >
      </h2>
    </div>

    <!-- Proyecto Insignia -->
    {yanesuProject && <ProjectFeaturedCard project={yanesuProject} />}

    <!-- Proyecto Secundario -->
    {
      tallerProject && (
        <ProjectSecondaryCard project={tallerProject} index={2} />
      )
    }
  </section>

  <!-- Habilidades / Core Competencies -->
  <section
    id="habilidades"
    class="scroll-reveal scroll-mt-28 max-w-5xl mx-auto px-4 py-16 space-y-8"
  >
    <div class="space-y-2">
      <span
        class="font-mono text-xs text-emerald-400 tracking-wider uppercase"
        style={`font-family: var(--font-mono)`}
      >
        02 / CORE COMPETENCIES
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-white leading-tight">
        Especialización técnica &amp;&nbsp;<em
          class="not-italic"
          style={`font-family: var(--font-serif); font-style: italic; font-weight: 400; color: #d4d4d8;`}
          >arquitectura por capas</em
        >
      </h2>
    </div>

    <SkillsMatrix />
  </section>

  <!-- Certificaciones / Validación Externa -->
  <section
    id="certificaciones"
    class="scroll-reveal scroll-mt-28 max-w-5xl mx-auto px-4 py-16 space-y-8"
  >
    <div class="space-y-2">
      <span
        class="font-mono text-xs text-emerald-400 tracking-wider uppercase"
        style={`font-family: var(--font-mono)`}
      >
        03 / VALIDACIÓN EXTERNA
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-white leading-tight">
        Certificaciones técnicas &amp;&nbsp;<em
          class="not-italic"
          style={`font-family: var(--font-serif); font-style: italic; font-weight: 400; color: #d4d4d8;`}
          >auditoría de habilidades</em
        >
      </h2>
    </div>

    <CertificationsBento />
  </section>

  <!-- Experiencia / Trayectoria Profesional -->
  <section
    id="experiencia"
    class="scroll-reveal scroll-mt-28 max-w-5xl mx-auto px-4 py-16 space-y-8"
  >
    <div class="space-y-2">
      <span
        class="font-mono text-xs text-emerald-400 tracking-wider uppercase"
        style={`font-family: var(--font-mono)`}
      >
        04 / TRAYECTORIA PROFESIONAL
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-white leading-tight">
        Experiencia laboral &amp;&nbsp;<em
          class="not-italic"
          style={`font-family: var(--font-serif); font-style: italic; font-weight: 400; color: #d4d4d8;`}
          >sistemas desplegados</em
        >
      </h2>
    </div>

    <ExperienceTimeline />
  </section>

  <!-- Pie de Página -->
  <Footer />
</Layout>
