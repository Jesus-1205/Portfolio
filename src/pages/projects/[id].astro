---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import WhitepaperHero from "../../components/whitepaper/WhitepaperHero.astro";
import TableOfContents from "../../components/whitepaper/TableOfContents.astro";
import MobileTableOfContents from "../../components/whitepaper/MobileTableOfContents.astro";
import TechStackCard from "../../components/whitepaper/TechStackCard.astro";
import ProjectNavigation from "../../components/whitepaper/ProjectNavigation.astro";
import CustomMDXImage from "../../components/whitepaper/CustomMDXImage.astro";
import VideoGif from "../../components/whitepaper/VideoGif.astro";
import CodeWindow from "../../components/whitepaper/CodeWindow.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order
  );
  return projects.map((project, index) => {
    const prev = index > 0 ? projects[index - 1] : null;
    const next = index < projects.length - 1 ? projects[index + 1] : null;
    return {
      params: { id: project.id },
      props: { project, prev, next },
    };
  });
}

const { project, prev, next } = Astro.props;
const { Content, headings } = await render(project);
---

<Layout
  title={`${project.data.title} — Especificación Técnica & Whitepaper`}
  description={project.data.tagline}
>
  <Navbar />

  <div class="max-w-6xl mx-auto px-4 pt-32 pb-20 w-full space-y-12">
    <!-- Header del Whitepaper con métricas y títulos -->
    <WhitepaperHero project={project} />

    <!-- Split Layout: Sidebar adhesiva (4 cols), Contenido a la derecha (8 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Columna Lateral Sticky con scroll interno independiente -->
      <div class="lg:col-span-4 order-2 lg:order-1 lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto custom-scrollbar flex flex-col gap-5">
        <TableOfContents headings={headings} />
        <TechStackCard stack={project.data.stack} />
      </div>

      <!-- Columna de Lectura Técnica -->
      <article class="lg:col-span-8 order-1 lg:order-2 whitepaper-prose min-w-0">
        <MobileTableOfContents headings={headings} />
        <Content components={{ img: CustomMDXImage, VideoGif, CodeWindow }} />
      </article>
    </div>

    <!-- Paginación al siguiente proyecto -->
    <ProjectNavigation prev={prev} next={next} />
  </div>

  <Footer />
</Layout>
