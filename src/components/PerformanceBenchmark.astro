---
// PerformanceBenchmark.astro — Telemetría y Benchmarking Auditado (Whitepaper-yanesu.md §4.2)

const benchmarks = [
  {
    endpoint: "GET /api/sales/summary",
    concept: "Cálculo analítico de ventas y márgenes diarios (Push-down a SQL)",
    baseline: "863.6 ms",
    optimized: "184.7 ms",
    improvement: "-78.6%",
    multiplier: "4.7x más rápido",
    baselinePercent: 100,
    optimizedPercent: 21.4,
  },
  {
    endpoint: "GET /api/invoices?page=1",
    concept: "Historial paginado y payload de red (51.82 KB a 7.86 KB)",
    baseline: "352.6 ms",
    optimized: "58.0 ms",
    improvement: "-83.6%",
    multiplier: "6.1x más rápido",
    baselinePercent: 40.8,
    optimizedPercent: 6.7,
  },
  {
    endpoint: "Handshake TCP Conexión Inicial",
    concept: "Resolución DNS IPv6 (::1) a IPv4 en entornos Windows desktop",
    baseline: "2.047 ms",
    optimized: "8.4 ms",
    improvement: "-98.9%",
    multiplier: "Elimina congelamiento de 2s",
    baselinePercent: 100,
    optimizedPercent: 0.4,
  },
];
---

<div class="rounded-2xl border border-white/10 bg-[#121215] p-6 sm:p-8 space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/5 pb-5">
    <div>
      <span
        class="font-mono text-xs text-sky-400 tracking-wider uppercase font-medium"
        style={`font-family: var(--font-mono)`}
      >
        TELEMETRÍA DE RENDIMIENTO AUDITADA
      </span>
      <h3 class="text-xl font-bold text-white tracking-tight mt-1">
        Impacto Cuantitativo: MVP Baseline vs. Producción Optimizada
      </h3>
    </div>
    <div class="flex items-center gap-4 text-xs font-mono text-neutral-400" style={`font-family: var(--font-mono)`}>
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-neutral-600"></span>
        <span>MVP Original</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        <span class="text-emerald-400 font-medium">Optimizada</span>
      </div>
    </div>
  </div>

  <div class="space-y-6">
    {
      benchmarks.map((b) => (
        <div class="space-y-2">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-xs">
            <span class="font-mono text-white font-medium" style={`font-family: var(--font-mono)`}>
              {b.endpoint}
              <span class="text-neutral-500 font-normal ml-2 block sm:inline">({b.concept})</span>
            </span>
            <div class="flex items-center gap-2 font-mono" style={`font-family: var(--font-mono)`}>
              <span class="text-neutral-500 line-through">{b.baseline}</span>
              <span class="text-emerald-400 font-bold">{b.optimized}</span>
              <span class="px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px]">
                {b.improvement}
              </span>
            </div>
          </div>

          <!-- Barras de comparación visual -->
          <div class="space-y-1.5">
            <!-- Barra baseline -->
            <div class="w-full h-2 rounded-full bg-neutral-900 overflow-hidden relative">
              <div
                class="h-full bg-neutral-700/60 rounded-full transition-all duration-500"
                style={`width: ${b.baselinePercent}%`}
              ></div>
            </div>
            <!-- Barra optimizada -->
            <div class="w-full h-2 rounded-full bg-neutral-900 overflow-hidden relative">
              <div
                class="h-full bg-emerald-500 rounded-full transition-all duration-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]"
                style={`width: ${Math.max(b.optimizedPercent, 2)}%`}
              ></div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>
