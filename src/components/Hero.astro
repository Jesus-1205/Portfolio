---
// Hero.astro — Hero Técnico Interactivo (design.md §3.2 + docs/Specs.md §Hero)
---

<section class="flex flex-col gap-8">
  <!-- A. Badge de disponibilidad -->
  <div
    class="inline-flex items-center gap-2.5 self-start rounded-full border border-white/10 bg-neutral-900/60 px-3.5 py-1.5"
  >
    <span class="relative flex h-2 w-2 shrink-0">
      <span
        class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
        aria-hidden="true"></span>
      <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"
      ></span>
    </span>
    <span
      class="font-mono text-xs text-neutral-300 uppercase tracking-wider"
      style={`font-family: var(--font-mono)`}
    >
      Disponible para roles&nbsp;·&nbsp;Enfocado en sistemas transaccionales
    </span>
  </div>

  <!-- B. Título principal H1 — Híbrido Sans + Serif itálica -->
  <h1
    class="text-4xl sm:text-5xl md:text-[3.5rem] font-extrabold tracking-tight text-white leading-[1.1] max-w-3xl"
  >
    Arquitectura de software<br class="hidden sm:block" />&amp;&nbsp;<em
      class="not-italic"
      style={`font-family: var(--font-serif); font-style: italic; font-weight: 400; color: #d4d4d8;`}
      >sistemas transaccionales</em
    ><br class="hidden sm:block" /> de alta disponibilidad
  </h1>

  <!-- C. Subtítulo técnico -->
  <p
    class="max-w-2xl text-left text-neutral-400 leading-relaxed text-base sm:text-lg"
  >
    Desarrollo Full-Stack con <strong class="text-neutral-200 font-medium"
      >TypeScript (React&nbsp;19)</strong
    > y <strong class="text-neutral-200 font-medium">Python (FastAPI)</strong>,
    modelado de datos transaccionales en <strong
      class="text-neutral-200 font-medium"
      >PostgreSQL&nbsp;/&nbsp;SQLite&nbsp;en&nbsp;</strong
    > con integridad referencial estricta y snapshots inmutables
  </p>

  <!-- D. CTA Bar -->
  <div class="flex flex-wrap items-center gap-3">
    <!-- Botón primario -->
    <a
      href="mailto:jesusenriqueblanco16@gmail.com?subject=Contacto%20Profesional%20—%20Jesús%20Blanco"
      class="inline-flex items-center bg-white text-neutral-950 font-medium px-5 py-2.5 rounded-full hover:bg-neutral-200 transition-colors duration-150 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
    >
      Contacto
    </a>

    <!-- Quick-Copy Email -->
    <button
      id="copy-email-btn"
      aria-label="Copiar dirección de correo electrónico"
      class="inline-flex items-center gap-2 border border-white/10 bg-neutral-900/60 hover:bg-neutral-800 text-neutral-300 px-4 py-2.5 rounded-full text-sm transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30 cursor-pointer"
    >
      <!-- Icono clipboard (estado inicial) -->
      <svg
        id="icon-copy"
        xmlns="http://www.w3.org/2000/svg"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect>
        <path
          d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"
        ></path>
      </svg>
      <!-- Icono check (estado copiado, oculto por defecto) -->
      <svg
        id="icon-check"
        xmlns="http://www.w3.org/2000/svg"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#10b981"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="hidden"
      >
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span id="copy-email-label">jesusenriqueblanco16@gmail.com</span>
    </button>

    <!-- GitHub -->
    <a
      href="https://github.com/Jesus-1205"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Perfil de GitHub"
      class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-white/10 bg-neutral-900/60 hover:bg-neutral-800 text-neutral-400 hover:text-white transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"
        ></path>
      </svg>
    </a>

    <!-- LinkedIn -->
    <a
      href="https://www.linkedin.com/in/jesus-enrique-blanco-villalobos"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Perfil de LinkedIn"
      class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-white/10 bg-neutral-900/60 hover:bg-neutral-800 text-neutral-400 hover:text-white transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="17"
        height="17"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
        ></path>
      </svg>
    </a>
  </div>

  <!-- E. Stats Bar — Métricas condensadas -->
  <div
    class="flex flex-wrap items-center gap-x-5 gap-y-2 pt-2"
    style={`font-family: var(--font-mono)`}
  >
    {
      [
        { value: "2.662", label: "tests pasando" },
        { value: "-65.8%", label: "latencia crítica" },
        { value: "+7.000", label: "registros migrados" },
        { value: "+6 meses", label: "uptime en producción" },
      ].map(({ value, label }, i) => (
        <>
          {i > 0 && (
            <span
              class="text-neutral-700 text-xs select-none"
              aria-hidden="true"
            >
              ·
            </span>
          )}
          <span class="text-xs text-neutral-500">
            <span class="text-neutral-300 font-medium">{value}</span>&nbsp;
            {label}
          </span>
        </>
      ))
    }
  </div>
</section>

<!-- Script nativo: Quick-Copy Email -->
<script>
  const btn = document.getElementById("copy-email-btn");
  const iconCopy = document.getElementById("icon-copy");
  const iconCheck = document.getElementById("icon-check");
  const label = document.getElementById("copy-email-label");

  const EMAIL = "jesusenriqueblanco16@gmail.com";
  let timer: ReturnType<typeof setTimeout> | null = null;

  btn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(EMAIL);

      // Swap visual: clipboard → check
      iconCopy?.classList.add("hidden");
      iconCheck?.classList.remove("hidden");
      if (label) label.textContent = "¡Copiado!";

      // Limpiar timer previo si el usuario hace clic rápido
      if (timer) clearTimeout(timer);

      timer = setTimeout(() => {
        iconCopy?.classList.remove("hidden");
        iconCheck?.classList.add("hidden");
        if (label) label.textContent = EMAIL;
        timer = null;
      }, 2000);
    } catch {
      // Fallback silencioso si el clipboard API no está disponible
      console.warn("Clipboard API no disponible");
    }
  });
</script>
