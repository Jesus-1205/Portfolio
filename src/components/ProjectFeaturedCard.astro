---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;

// Aplanar todas las capas del stack en un único array
const allStackTags = [
  ...data.stack.backend,
  ...data.stack.frontend,
  ...data.stack.database,
  ...data.stack.devops,
];
---

<article
  class="rounded-2xl border border-white/10 bg-[#121215] hover:border-white/20 transition-all duration-300 p-6 sm:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center"
>
  <!-- ── Columna Izquierda: Mockup Visual (5 cols) ── -->
  <div class="lg:col-span-5 flex flex-col gap-3">
    <!-- Marco estilo terminal -->
    <div class="rounded-xl overflow-hidden border border-white/8 bg-neutral-950">
      <!-- Barra superior del terminal -->
      <div class="flex items-center gap-1.5 px-3 py-2.5 bg-neutral-900/80 border-b border-white/5">
        <span class="h-2.5 w-2.5 rounded-full bg-red-500/70"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-yellow-500/70"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-green-500/70"></span>
        <span
          class="ml-3 font-mono text-[10px] text-neutral-600 tracking-wide"
          style={`font-family: var(--font-mono)`}
        >
          {project.id}.system — live
        </span>
      </div>

      <!-- Área visual del sistema -->
      <div
        class="aspect-video bg-neutral-950 flex flex-col items-center justify-center gap-4 px-6"
      >
        <!-- Icono representativo del sistema -->
        <div class="flex flex-col items-center gap-3 w-full">
          <div
            class="flex items-center gap-2 text-emerald-400"
            style={`font-family: var(--font-mono)`}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span class="text-xs tracking-wider">{data.productionStatus.toUpperCase()}</span>
          </div>

          <!-- Métrica destacada del sistema -->
          <div class="text-center">
            <p
              class="text-4xl font-extrabold text-white tabular-nums"
              style={`font-family: var(--font-mono)`}
            >
              {data.heroMetrics[0].value}
            </p>
            <p class="text-xs text-neutral-500 mt-1" style={`font-family: var(--font-mono)`}>
              {data.heroMetrics[0].label}
            </p>
          </div>

          <!-- Barra de progreso decorativa -->
          <div class="w-full max-w-[180px] h-px bg-white/5 relative">
            <span class="absolute inset-y-0 left-0 bg-emerald-500/60 w-[65%]"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Badges de entorno de despliegue -->
    <div class="flex flex-wrap gap-2">
      <span
        class="inline-flex items-center gap-1.5 rounded-md border border-white/8 bg-neutral-900/60 px-2.5 py-1 font-mono text-[10px] text-neutral-400 tracking-wide"
        style={`font-family: var(--font-mono)`}
      >
        <span class="h-1.5 w-1.5 rounded-full bg-sky-400/80"></span>
        DOCKER VPS (POSTGRESQL 16)
      </span>
      <span
        class="inline-flex items-center gap-1.5 rounded-md border border-white/8 bg-neutral-900/60 px-2.5 py-1 font-mono text-[10px] text-neutral-400 tracking-wide"
        style={`font-family: var(--font-mono)`}
      >
        <span class="h-1.5 w-1.5 rounded-full bg-amber-400/80"></span>
        TAURI 2 RUST (SQLITE EDGE)
      </span>
    </div>
  </div>

  <!-- ── Columna Derecha: Ficha Técnica (7 cols) ── -->
  <div class="lg:col-span-7 flex flex-col gap-5">

    <!-- Badge de categoría + timeframe -->
    <div
      class="font-mono text-xs text-emerald-400 tracking-wider uppercase"
      style={`font-family: var(--font-mono)`}
    >
      POS &amp; ERP TRANSACCIONAL&nbsp;·&nbsp;{data.timeframe}
    </div>

    <!-- Título con View Transition -->
    <div class="-mt-1">
      <h3
        transition:name={`project-title-${project.id}`}
        class="text-2xl sm:text-3xl font-bold text-white leading-snug"
      >
        {data.title}
      </h3>
      <p class="mt-2 text-sm text-neutral-400 leading-relaxed">
        {data.tagline}
      </p>
    </div>

    <!-- Hero Metrics: Cuadrícula 2×2 (referencia FOTO B) -->
    <div class="grid grid-cols-2 gap-2.5">
      {
        data.heroMetrics.map((metric) => (
          <div class="bg-neutral-900/60 border border-white/5 rounded-lg p-3 flex flex-col gap-1">
            <span class="text-xl font-bold text-white tabular-nums leading-none">
              {metric.value}
            </span>
            <span class="text-[11px] text-neutral-400 leading-tight">{metric.label}</span>
            <span
              class="text-[10px] text-neutral-600 leading-tight"
              style={`font-family: var(--font-mono)`}
            >
              {metric.detail}
            </span>
          </div>
        ))
      }
    </div>

    <!-- Viñetas técnicas derivadas de los datos del proyecto -->
    <ul class="flex flex-col gap-2">
      <li class="flex items-start gap-2.5 text-sm text-neutral-300">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" aria-hidden="true"
        ></span>
        <span>
          <strong class="text-white font-medium">Arquitectura: </strong>
          {data.architecture.pattern}
        </span>
      </li>
      <li class="flex items-start gap-2.5 text-sm text-neutral-300">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" aria-hidden="true"
        ></span>
        <span>
          <strong class="text-white font-medium">SDD scope: </strong>
          {data.methodologies.sddScope}
        </span>
      </li>
      <li class="flex items-start gap-2.5 text-sm text-neutral-300">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" aria-hidden="true"
        ></span>
        <span>
          <strong class="text-white font-medium">Suite de calidad: </strong>
          {data.methodologies.testCount.total} tests — {
            data.methodologies.testingFrameworks.join(", ")
          }
        </span>
      </li>
    </ul>

    <!-- Chips del stack -->
    <div class="flex flex-wrap gap-1.5">
      {
        allStackTags.map((tag) => (
          <span
            class="bg-white/5 text-neutral-300 text-xs px-2.5 py-1 rounded-md font-mono hover:bg-white/10 hover:border-white/20 border border-white/5 transition-colors duration-150"
            style={`font-family: var(--font-mono)`}
          >
            {tag}
          </span>
        ))
      }
    </div>

    <!-- CTA -->
    <div class="pt-1">
      <a
        href={`/projects/${project.id}`}
        class="inline-flex items-center gap-1.5 text-sm font-medium text-white hover:text-emerald-400 transition-colors duration-150 group"
      >
        Ver Especificación Técnica
        <span
          class="transition-transform duration-150 group-hover:translate-x-0.5"
          aria-hidden="true">→</span
        >
      </a>
    </div>
  </div>
</article>
