---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
---

<header class="flex flex-col gap-8 pb-12 border-b border-white/10">
  <!-- Navegación de retorno -->
  <div class="flex items-center justify-between">
    <a
      href="/#proyectos"
      class="inline-flex items-center gap-2 text-xs font-mono text-neutral-400 hover:text-white transition-colors duration-150 group"
      style={`font-family: var(--font-mono)`}
    >
      <span class="transition-transform duration-150 group-hover:-translate-x-1">←</span>
      <span>Volver a proyectos</span>
    </a>

    <div class="flex items-center gap-2">
      <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span
        class="font-mono text-[10px] text-emerald-400 uppercase tracking-wider"
        style={`font-family: var(--font-mono)`}
      >
        {data.productionStatus}
      </span>
    </div>
  </div>

  <!-- Encabezado Principal -->
  <div class="space-y-4 max-w-4xl">
    <div
      class="font-mono text-xs text-emerald-400 tracking-wider uppercase font-medium"
      style={`font-family: var(--font-mono)`}
    >
      CASO DE ESTUDIO DE INGENIERÍA · {data.timeframe}
    </div>

    <!-- Título con View Transition compartida con la home -->
    <h1
      transition:name={`project-title-${project.id}`}
      class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-[1.15]"
    >
      {data.title}
    </h1>

    <p class="text-base sm:text-xl text-neutral-300 leading-relaxed max-w-3xl">
      {data.tagline}
    </p>
  </div>

  <!-- Barra de Metadatos de Ingeniería & Botón GitHub -->
  <div class="flex flex-wrap items-center justify-between gap-4 pt-2 border-t border-white/5">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-mono text-neutral-400" style={`font-family: var(--font-mono)`}>
      <div>
        <span class="text-neutral-500">ROL: </span>
        <span class="text-neutral-200">{data.role}</span>
      </div>
      <span class="text-neutral-700 hidden sm:inline">·</span>
      <div>
        <span class="text-neutral-500">CONTEXTO: </span>
        <span class="text-neutral-200">{data.clientOrContext}</span>
      </div>
    </div>

    {data.links?.repo && (
      <a
        href={data.links.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-[#121215] px-3.5 py-1.5 font-mono text-xs text-neutral-300 hover:border-white/30 hover:bg-neutral-900 hover:text-white transition-all duration-200"
      >
        <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0.297C5.37 0.297 0 5.67 0 12.297c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297 24 5.67 18.627 0.297 12 0.297z" />
        </svg>
        <span>Repositorio Oficial ↗</span>
      </a>
    )}
  </div>

  <!-- Hero Metrics Grid -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 pt-2">
    {
      data.heroMetrics.map((m) => (
        <div class="rounded-xl border border-white/5 bg-[#121215] p-4 flex flex-col gap-1">
          <span class="text-xl sm:text-2xl font-bold text-white tabular-nums" style={`font-family: var(--font-mono)`}>
            {m.value}
          </span>
          <span class="text-xs font-medium text-neutral-300">{m.label}</span>
          <span class="text-[11px] text-neutral-500 font-mono leading-tight pt-1" style={`font-family: var(--font-mono)`}>
            {m.detail}
          </span>
        </div>
      ))
    }
  </div>
</header>
