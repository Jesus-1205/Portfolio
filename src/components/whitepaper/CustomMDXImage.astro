---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import VideoGif from "./VideoGif.astro";

interface Props {
  src: string | ImageMetadata;
  alt?: string;
  width?: number | string;
  height?: number | string;
  loading?: "lazy" | "eager";
  decoding?: "async" | "sync" | "auto";
  [key: string]: any;
}

const { src, alt = "", width, height, loading = "lazy", decoding = "async", ...rest } = Astro.props;

const isMetadata = typeof src === "object" && src !== null;

let imageSrc = isMetadata ? (src as ImageMetadata).src : (src as string);
let imageWidth = width ?? (isMetadata ? (src as ImageMetadata).width : undefined);
let imageHeight = height ?? (isMetadata ? (src as ImageMetadata).height : undefined);

// Si es un objeto de metadatos de imagen local, optimizarlo a WebP vía Sharp
if (isMetadata) {
  try {
    const optimized = await getImage({
      src: src as ImageMetadata,
      format: "webp",
      quality: 85,
    });
    imageSrc = optimized.src;
    imageWidth = optimized.attributes.width || imageWidth;
    imageHeight = optimized.attributes.height || imageHeight;
  } catch (e) {
    console.error("Error optimizando imagen con getImage:", e);
  }
}

// Si la imagen solicitada es un GIF, interceptarlo y servir el componente optimizado VideoGif
const isGif = typeof imageSrc === "string" && imageSrc.toLowerCase().includes(".gif");
---

{isGif ? (
  <VideoGif
    src={imageSrc}
    alt={alt}
    caption={alt}
  />
) : (
  <div class="my-6 rounded-xl overflow-hidden border border-white/10 bg-[#0c0c10] shadow-xl group transition-all duration-300 hover:border-white/20">
    <img
      src={imageSrc}
      alt={alt}
      width={imageWidth}
      height={imageHeight}
      loading={loading}
      decoding={decoding}
      class="w-full h-auto block m-0 rounded-none border-0 object-contain"
      {...rest}
    />
  </div>
)}
