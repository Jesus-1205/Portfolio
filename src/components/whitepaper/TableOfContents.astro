---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  stack: {
    frontend: string[];
    backend: string[];
    database: string[];
    devops: string[];
  };
}

const { headings, stack } = Astro.props;
const filteredHeadings = (headings || []).filter((h) => h.depth === 2 || h.depth === 3);
---

<aside class="space-y-5">
  <!-- Tabla de Contenidos -->
  <div class="rounded-2xl border border-white/10 bg-[#121215] p-5 space-y-4">
    <div class="flex items-center justify-between border-b border-white/5 pb-3">
      <span
        class="font-mono text-xs uppercase tracking-wider text-emerald-400 font-medium"
        style={`font-family: var(--font-mono)`}
      >
        TABLA DE CONTENIDOS
      </span>
      <span class="text-[10px] font-mono text-neutral-500" style={`font-family: var(--font-mono)`}>
        {filteredHeadings.length} SECCIONES
      </span>
    </div>

    <nav aria-label="Índice del reporte" class="space-y-1 text-xs font-mono" style={`font-family: var(--font-mono)`}>
      <ul class="space-y-1">
        {
          filteredHeadings.map((heading) => (
            <li class={heading.depth === 3 ? "pl-3.5 border-l border-white/5 ml-1" : ""}>
              <a
                href={`#${heading.slug}`}
                title={heading.text}
                class="toc-link block py-1 text-neutral-400 hover:text-white transition-colors duration-150 leading-snug break-words"
                data-target={heading.slug}
              >
                {heading.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Botón Volver Arriba -->
    <div class="pt-3 border-t border-white/5">
      <button
        type="button"
        id="toc-back-to-top"
        class="w-full text-center py-1.5 text-xs font-mono text-neutral-400 hover:text-white transition-colors cursor-pointer"
        style={`font-family: var(--font-mono)`}
      >
        ↑ Subir al inicio del reporte
      </button>
    </div>
  </div>

  <!-- Ficha de Stack Tecnológico Compacto -->
  <div class="rounded-2xl border border-white/10 bg-[#121215] p-4 space-y-3">
    <span
      class="font-mono text-[11px] uppercase tracking-wider text-neutral-400 font-medium block border-b border-white/5 pb-2"
      style={`font-family: var(--font-mono)`}
    >
      STACK POR CAPAS
    </span>

    <div class="space-y-2.5 text-xs">
      <div>
        <span class="text-[10px] font-mono text-emerald-400 uppercase tracking-wide block mb-1">Backend & Core</span>
        <div class="flex flex-wrap gap-1">
          {stack?.backend?.map((t) => (
            <span class="bg-neutral-900/80 border border-white/5 text-neutral-300 font-mono text-[10px] px-2 py-0.5 rounded">
              {t}
            </span>
          ))}
        </div>
      </div>

      <div>
        <span class="text-[10px] font-mono text-sky-400 uppercase tracking-wide block mb-1">Frontend & Estado</span>
        <div class="flex flex-wrap gap-1">
          {stack?.frontend?.map((t) => (
            <span class="bg-neutral-900/80 border border-white/5 text-neutral-300 font-mono text-[10px] px-2 py-0.5 rounded">
              {t}
            </span>
          ))}
        </div>
      </div>

      <div>
        <span class="text-[10px] font-mono text-indigo-400 uppercase tracking-wide block mb-1">Persistencia</span>
        <div class="flex flex-wrap gap-1">
          {stack?.database?.map((t) => (
            <span class="bg-neutral-900/80 border border-white/5 text-neutral-300 font-mono text-[10px] px-2 py-0.5 rounded">
              {t}
            </span>
          ))}
        </div>
      </div>

      <div>
        <span class="text-[10px] font-mono text-amber-400 uppercase tracking-wide block mb-1">Infraestructura & Edge</span>
        <div class="flex flex-wrap gap-1">
          {stack?.devops?.map((t) => (
            <span class="bg-neutral-900/80 border border-white/5 text-neutral-300 font-mono text-[10px] px-2 py-0.5 rounded">
              {t}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</aside>

<style is:global>
  .custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
  }
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.2);
  }
</style>

<script>
  function setupTOC() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");
            document.querySelectorAll(".toc-link").forEach((link) => {
              if (link.getAttribute("data-target") === id) {
                link.classList.add("text-emerald-400", "font-medium");
                link.classList.remove("text-neutral-400");
              } else {
                link.classList.remove("text-emerald-400", "font-medium");
                link.classList.add("text-neutral-400");
              }
            });
          }
        });
      },
      { rootMargin: "0px 0px -70% 0px" }
    );

    document.querySelectorAll(".whitepaper-prose h2, .whitepaper-prose h3").forEach((h) => {
      observer.observe(h);
    });

    document.getElementById("toc-back-to-top")?.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }

  document.addEventListener("astro:page-load", setupTOC);
</script>
