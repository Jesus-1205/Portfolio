---
// Navbar.astro — Floating Island Navbar (design.md §3.1)
---

<header class="fixed top-4 inset-x-0 z-50 flex justify-center px-4">
  <nav
    aria-label="Navegación principal"
    class="flex items-center gap-6 rounded-full border border-white/10 bg-neutral-950/95 px-5 py-2 backdrop-blur-xl shadow-2xl shadow-black/50"
  >
    <!-- Monograma / Identificador -->
    <a
      href="/"
      class="font-semibold text-sm text-white tracking-tight shrink-0 select-none"
      aria-label="Inicio — Jesús Blanco"
    >
      JB.
    </a>

    <!-- Separador visual -->
    <span class="hidden md:block h-4 w-px bg-white/10" aria-hidden="true"
    ></span>

    <!-- Enlaces ancla -->
    <ul class="hidden md:flex items-center gap-1" role="list">
      {
        [
          { href: "#proyectos", label: "Proyectos" },
          { href: "#habilidades", label: "Habilidades" },
          { href: "#certificaciones", label: "Certificaciones" },
          { href: "#experiencia", label: "Experiencia" },
        ].map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="px-3 py-1.5 rounded-full text-sm text-neutral-400 hover:text-white hover:bg-white/5 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Separador visual -->
    <span class="hidden md:block h-4 w-px bg-white/10" aria-hidden="true"
    ></span>

    <!-- CTA Contacto -->
    <a
      href="mailto:jesusenriqueblanco16@gmail.com?subject=Contacto%20Profesional%20—%20Jesús%20Blanco"
      class="shrink-0 text-sm font-medium px-4 py-1.5 rounded-full border border-white/15 text-white hover:bg-white/10 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
    >
      Contacto
    </a>
  </nav>
</header>
