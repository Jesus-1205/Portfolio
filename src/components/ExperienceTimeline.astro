---
// ExperienceTimeline.astro — Historial de Experiencia & Bento de Presencia (design.md §6.1)

const roles = [
  {
    role: "Full-Stack Software Engineer",
    company: "Yanesu Shisutemu — Retail POS & ERP",
    period: "Jul 2026 — Presente",
    status: "Producción Activa",
    isCurrent: true,
    impact:
      "Diseño e implementación de arquitectura transaccional bimoneda (USD/VES) con despliegue híbrido Cloud VPS (Docker/PostgreSQL 16) y Desktop Edge (Tauri 2 en Rust).",
    achievements: [
      "Reducción de latencia en un 65.8% (184 ms a 63 ms) y de payload en 76.3% mediante push-down a SQL y optimización de streams SSE.",
      "Motor financiero con aritmética Decimal estricta (cero floats), inventario bimodal con auto-unboxing e ingestión OCR de facturas con Gemini AI.",
      "Suite de 2.662 pruebas automatizadas bajo SDD/TDD; código de seed y testing indexado en XERJ Corpus Hub (+16k ⭐ en GitHub).",
    ],
    stack: [
      "React 19",
      "TypeScript",
      "FastAPI",
      "PostgreSQL 16",
      "Tauri 2",
      "Docker",
      "Zustand",
    ],
  },
  {
    role: "Software Engineer / Consultor de Sistemas",
    company: "Auto Servicios Villalobos, C.A.",
    period: "Sep 2025 — Presente",
    status: "Producción Activa",
    isCurrent: true,
    impact:
      "Liderazgo técnico en la transformación digital integral y migración de sistemas legados hacia arquitectura relacional.",
    achievements: [
      "Pipeline ETL para ingesta, depuración y normalización de 8 años de registros (+7.000 presupuestos y clientes) de Excel a 3NF.",
      "Algoritmo transaccional create_split con bloqueo pesimista (.with_for_update()) para particionado atómico en formas continuas fiscales.",
      "Despliegue en producción sobre hosting compartido Linux (cPanel / Phusion Passenger) con +6 meses de uptime ininterrumpido.",
    ],
    stack: [
      "FastAPI",
      "SQLAlchemy 2.0",
      "SQLite (DELETE mode)",
      "Jinja2",
      "cPanel",
      "Python",
    ],
  },
];
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
  <!-- ── Columna Izquierda: Historial Laboral (7 cols) ── -->
  <div class="lg:col-span-7 border-l border-white/10 pl-6 space-y-10 relative">
    {
      roles.map((item) => (
        <div class="relative flex flex-col gap-3 group">
          <!-- Punto de la línea de tiempo -->
          <div
            class="absolute -left-[31px] top-1.5 h-2.5 w-2.5 rounded-full border border-neutral-950 bg-emerald-400 ring-4 ring-emerald-500/20"
            aria-hidden="true"
          />

          <!-- Período + Badge de Estatus + Entidad -->
          <div class="flex flex-wrap items-center gap-2">
            <span
              class="font-mono text-xs text-neutral-400 uppercase tracking-wider"
              style={`font-family: var(--font-mono)`}
            >
              {item.period}
            </span>
            <span
              class="font-mono text-[10px] text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded-full uppercase tracking-wider font-medium"
              style={`font-family: var(--font-mono)`}
            >
              {item.status}
            </span>
            <span class="text-neutral-600 select-none" aria-hidden="true">·</span>
            <span class="text-xs font-medium text-emerald-400">
              {item.company}
            </span>
          </div>

          <!-- Cargo -->
          <h3 class="text-lg font-bold text-white tracking-tight leading-snug">
            {item.role}
          </h3>

          <!-- Impacto / Descripción -->
          <p class="text-sm text-neutral-400 leading-relaxed">
            {item.impact}
          </p>

          <!-- Viñetas de logros -->
          <ul class="flex flex-col gap-2 pt-1">
            {item.achievements.map((achievement) => (
              <li class="flex items-start gap-2.5 text-sm text-neutral-300">
                <span
                  class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500"
                  aria-hidden="true"
                />
                <span class="leading-relaxed">{achievement}</span>
              </li>
            ))}
          </ul>

          <!-- Stack utilizado -->
          <div class="flex flex-wrap gap-1.5 pt-2">
            {item.stack.map((tech) => (
              <span
                class="bg-white/5 text-neutral-300 text-xs px-2.5 py-1 rounded-md font-mono border border-white/5 select-none"
                style={`font-family: var(--font-mono)`}
              >
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <!-- ── Columna Derecha: Bento de Presencia y Redes (5 cols) ── -->
  <div class="lg:col-span-5 space-y-4">
    <!-- Tarjeta GitHub -->
    <article
      class="rounded-2xl border border-white/10 bg-[#121215] p-6 hover:border-white/20 transition-all duration-300 flex flex-col justify-between gap-5 group"
    >
      <div class="flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="p-2 rounded-lg bg-white/5 border border-white/5 text-white">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"
                />
              </svg>
            </div>
            <div>
              <span
                class="font-mono text-xs text-neutral-400 block"
                style={`font-family: var(--font-mono)`}
              >
                OPEN SOURCE &amp; REPOS
              </span>
              <span class="font-bold text-white text-base">@Jesus-1205</span>
            </div>
          </div>
          <span
            class="text-neutral-500 group-hover:text-white transition-colors"
            aria-hidden="true"
          >
            ↗
          </span>
        </div>

        <p class="text-xs text-neutral-400 leading-relaxed pt-1">
          Código de seed y testing indexado en <strong class="text-neutral-200 font-medium"
            >XERJ Corpus Hub</strong
          > (+16k ⭐ en GitHub).
        </p>
      </div>

      <div class="pt-2 border-t border-white/5">
        <a
          href="https://github.com/Jesus-1205"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-300 hover:text-white transition-colors duration-150"
          style={`font-family: var(--font-mono)`}
        >
          <span>Explorar Perfil en GitHub</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </article>

    <!-- Tarjeta LinkedIn -->
    <article
      class="rounded-2xl border border-white/10 bg-[#121215] p-6 hover:border-white/20 transition-all duration-300 flex flex-col justify-between gap-5 group"
    >
      <div class="flex flex-col gap-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="p-2 rounded-lg bg-sky-500/10 border border-sky-500/20 text-sky-400">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                />
              </svg>
            </div>
            <div>
              <span
                class="font-mono text-xs text-sky-400 block"
                style={`font-family: var(--font-mono)`}
              >
                RED PROFESIONAL
              </span>
              <span class="font-bold text-white text-base">Jesús Blanco</span>
            </div>
          </div>
          <span
            class="text-neutral-500 group-hover:text-white transition-colors"
            aria-hidden="true"
          >
            ↗
          </span>
        </div>

        <p class="text-xs text-neutral-400 leading-relaxed pt-1">
          Conectemos para discutir arquitectura de software, sistemas transaccionales y
          oportunidades laborales.
        </p>
      </div>

      <div class="pt-2 border-t border-white/5">
        <a
          href="https://linkedin.com/in/jesus-blanco"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-300 hover:text-white transition-colors duration-150"
          style={`font-family: var(--font-mono)`}
        >
          <span>Conectar en LinkedIn</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </article>
  </div>
</div>
