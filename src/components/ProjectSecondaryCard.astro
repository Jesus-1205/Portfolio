---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  index?: number;
}

const { project, index = 2 } = Astro.props;
const { data } = project;

// Aplanar stack para chips
const allStackTags = [
  ...data.stack.backend,
  ...data.stack.frontend,
  ...data.stack.database,
  ...data.stack.devops,
];

// Índice numérico formateado (02, 03, ...)
const watermark = String(index).padStart(2, "0");
---

<article
  class="p-6 sm:p-8 rounded-2xl border border-white/10 bg-[#121215] hover:border-white/20 relative overflow-hidden flex flex-col justify-between gap-6 transition-all duration-300"
>
  <!-- Marca de agua numérica -->
  <span
    class="font-mono text-8xl font-extrabold text-white/[0.03] absolute top-3 right-5 pointer-events-none select-none leading-none"
    aria-hidden="true"
    style={`font-family: var(--font-mono)`}
  >
    {watermark}
  </span>

  <!-- Contenido superior -->
  <div class="flex flex-col gap-5 relative z-10">

    <!-- Badge categoría + período -->
    <div
      class="font-mono text-xs text-emerald-400 tracking-wider uppercase"
      style={`font-family: var(--font-mono)`}
    >
      ERP AUTOMOTRIZ &amp; ETL&nbsp;·&nbsp;{data.timeframe}
    </div>

    <!-- Título -->
    <div class="-mt-1">
      <h3
        transition:name={`project-title-${project.id}`}
        class="text-xl sm:text-2xl font-bold text-white leading-snug"
      >
        {data.title}
      </h3>
      <p class="mt-2 text-sm text-neutral-400 leading-relaxed max-w-prose">
        {data.tagline}
      </p>
    </div>

    <!-- 4 métricas clave en grid 2×2 compacto -->
    <div class="grid grid-cols-2 gap-2">
      {
        data.heroMetrics.map((metric) => (
          <div class="flex flex-col gap-0.5 bg-neutral-900/40 border border-white/5 rounded-lg px-3 py-2.5">
            <span
              class="text-base font-bold text-white tabular-nums leading-none"
              style={`font-family: var(--font-mono)`}
            >
              {metric.value}
            </span>
            <span class="text-[11px] text-neutral-400 leading-tight">{metric.label}</span>
          </div>
        ))
      }
    </div>

    <!-- Viñeta técnica principal -->
    <ul class="flex flex-col gap-2">
      <li class="flex items-start gap-2.5 text-sm text-neutral-300">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" aria-hidden="true"
        ></span>
        <span>
          <strong class="text-white font-medium">Arquitectura: </strong>
          {data.architecture.pattern}
        </span>
      </li>
      <li class="flex items-start gap-2.5 text-sm text-neutral-300">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" aria-hidden="true"
        ></span>
        <span>
          <strong class="text-white font-medium">Persistencia: </strong>
          {data.architecture.databaseSchema}
        </span>
      </li>
    </ul>

    <!-- Chips del stack -->
    <div class="flex flex-wrap gap-1.5">
      {
        allStackTags.map((tag) => (
          <span
            class="bg-white/5 text-neutral-300 text-xs px-2.5 py-1 rounded-md font-mono border border-white/5 hover:bg-white/10 hover:border-white/20 transition-colors duration-150"
            style={`font-family: var(--font-mono)`}
          >
            {tag}
          </span>
        ))
      }
    </div>
  </div>

  <!-- CTA inferior -->
  <div class="relative z-10 pt-1 border-t border-white/5">
    <a
      href={`/projects/${project.id}`}
      class="inline-flex items-center gap-1.5 text-sm font-medium text-white hover:text-emerald-400 transition-colors duration-150 group"
    >
      Ver Especificación Técnica
      <span
        class="transition-transform duration-150 group-hover:translate-x-0.5"
        aria-hidden="true">→</span
      >
    </a>
  </div>
</article>
