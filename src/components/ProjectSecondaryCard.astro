---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  index?: number;
}

const { project, index = 2 } = Astro.props;
const { data } = project;

// Aplanar stack para chips
const allStackTags = [
  ...data.stack.backend,
  ...data.stack.frontend,
  ...data.stack.database,
  ...data.stack.devops,
];

// Índice numérico formateado (02, 03, ...)
const watermark = String(index).padStart(2, "0");
---

<article
  class="scroll-reveal p-6 sm:p-8 rounded-2xl border border-white/10 bg-[#121215] hover:border-white/20 relative overflow-hidden flex flex-col justify-between gap-6 transition-all duration-300"
>
  <!-- Marca de agua numérica -->
  <span
    class="font-mono text-8xl font-extrabold text-white/[0.03] absolute top-3 right-5 pointer-events-none select-none leading-none"
    aria-hidden="true"
    style={`font-family: var(--font-mono)`}
  >
    {watermark}
  </span>

  <!-- Contenido superior -->
  <div class="flex flex-col gap-5 relative z-10">

    <!-- Badge categoría + período -->
    <div
      class="font-mono text-xs text-emerald-400 tracking-wider uppercase"
      style={`font-family: var(--font-mono)`}
    >
      ERP AUTOMOTRIZ &amp; ETL&nbsp;·&nbsp;{data.timeframe}
    </div>

    <!-- Título -->
    <div class="-mt-1">
      <h3
        transition:name={`project-title-${project.id}`}
        class="text-xl sm:text-2xl font-bold text-white leading-snug"
      >
        {data.title}
      </h3>
      <p class="mt-2 text-sm text-neutral-400 leading-relaxed max-w-prose">
        {data.tagline}
      </p>
    </div>

    <!-- 4 métricas clave en grid 2×2 compacto -->
    <div class="grid grid-cols-2 gap-2">
      {
        data.heroMetrics.map((metric) => (
          <div class="flex flex-col gap-0.5 bg-neutral-900/40 border border-white/5 rounded-lg px-3 py-2.5">
            <span
              class="text-base font-bold text-white tabular-nums leading-none"
              style={`font-family: var(--font-mono)`}
            >
              {metric.value}
            </span>
            <span class="text-[11px] text-neutral-400 leading-tight">{metric.label}</span>
          </div>
        ))
      }
    </div>

    <!-- Viñeta técnica principal -->
    <ul class="flex flex-col gap-2">
      <li class="flex items-start gap-2.5 text-sm text-neutral-300">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" aria-hidden="true"
        ></span>
        <span>
          <strong class="text-white font-medium">Arquitectura: </strong>
          {data.architecture.pattern}
        </span>
      </li>
      <li class="flex items-start gap-2.5 text-sm text-neutral-300">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500" aria-hidden="true"
        ></span>
        <span>
          <strong class="text-white font-medium">Persistencia: </strong>
          {data.architecture.databaseSchema}
        </span>
      </li>
    </ul>

    <!-- Chips del stack -->
    <div class="flex flex-wrap gap-1.5">
      {
        allStackTags.map((tag) => (
          <span
            class="bg-white/5 text-neutral-300 text-xs px-2.5 py-1 rounded-md font-mono border border-white/5 hover:bg-white/10 hover:border-white/20 transition-colors duration-150"
            style={`font-family: var(--font-mono)`}
          >
            {tag}
          </span>
        ))
      }
    </div>
  </div>

  <!-- CTA inferior & Enlaces -->
  <div class="relative z-10 pt-3 border-t border-white/5 flex flex-wrap items-center justify-between gap-4">
    <a
      href={`/projects/${project.id}`}
      class="inline-flex items-center gap-1.5 text-sm font-medium text-white hover:text-emerald-400 transition-colors duration-150 group"
    >
      Ver Especificación Técnica
      <span
        class="transition-transform duration-150 group-hover:translate-x-0.5"
        aria-hidden="true">→</span
      >
    </a>

    {project.data.links?.repo && (
      <a
        href={project.data.links.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative inline-flex items-center gap-2 overflow-visible rounded-lg border border-white/10 bg-[#121215] px-3.5 py-1.5 font-mono text-xs text-neutral-300 transition-all duration-300 hover:border-white/30 hover:bg-neutral-900 hover:text-white"
        aria-label={`Ver código fuente de ${project.data.title} en GitHub`}
      >
        <!-- Cono de Luz Cenital (Spotlight adaptado de SalladShooter) -->
        <div 
          class="pointer-events-none absolute -top-8 left-1/2 -translate-x-1/2 h-8 w-20 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
          aria-hidden="true"
        >
          <!-- Punto emisor de luz (Dot) -->
          <div class="mx-auto h-1 w-1 rounded-full bg-white shadow-[0_0_8px_2px_rgba(255,255,255,0.8)]"></div>
          <!-- Haz de luz cónico con clip-path -->
          <div class="h-full w-full [clip-path:polygon(50%_0%,0%_100%,100%_100%)] bg-gradient-to-b from-white/25 via-white/5 to-transparent"></div>
        </div>

        <!-- Icono GitHub Oficial (kamehame-ha) -->
        <svg 
          class="relative z-10 h-3.5 w-3.5 fill-current text-neutral-400 transition-colors duration-200 group-hover:text-white" 
          viewBox="0 0 24 24" 
          aria-hidden="true"
        >
          <path d="M12 0.297C5.37 0.297 0 5.67 0 12.297c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297 24 5.67 18.627 0.297 12 0.297z" />
        </svg>

        <!-- Texto y flecha externa -->
        <span class="relative z-10 font-medium tracking-wide">Repositorio</span>
        <span class="relative z-10 text-neutral-500 transition-colors group-hover:text-neutral-300">↗</span>
      </a>
    )}
  </div>
</article>
